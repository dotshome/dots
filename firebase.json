{
  "hosting": {
    "site": "dothome-world",
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "**/.*",
      "**/*.log",
      "**/node_modules/**",
      "server/**",
      "blender/**",
      "package.json",
      "package-lock.json",
      "assets/preview.png",
      "chronicle/**",
      "README.md",
      "firebase-config.example.js"
    ],
    "headers": [
      { "source": "**/*.@(html|js)", "headers": [{ "key": "Cache-Control", "value": "no-cache" }] },
      { "source": "**/*.glb", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
